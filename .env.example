# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================

# Neon pooled connection URL (usar para queries con Prisma)
# Formato: postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# Neon direct connection URL (usar para migrations)
# Formato: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=""

# ============================================
# NEXT.JS
# ============================================

# URL de la aplicación (desarrollo)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# ALERTAS (Opcional)
# ============================================

# Slack Webhook URL para alertas críticas
# Crear en: https://api.slack.com/messaging/webhooks
# Ejemplo: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=""
